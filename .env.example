# Copy to .env (gitignored) and adjust. Never commit .env.
#
# Standard libpq variables: read by psycopg, psql and dbt alike, and by
# docker compose to configure the container. One set of settings for everything.
PGHOST=localhost
PGPORT=5433
PGUSER=rwe
PGPASSWORD=rwe_local_only
PGDATABASE=rwe

# Config profile from config/pipeline.yaml ("default" or "ci").
RWE_PROFILE=default

# LLM settings (used from Phase 6; nothing calls an API before then).
# LLM_PROVIDER=anthropic
# LLM_MODEL=
# LLM_BUDGET_USD=5.00
# ANTHROPIC_API_KEY=
